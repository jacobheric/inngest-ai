{
  "lock": false,
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "deno run -A vite",
    "build": "deno run -A vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "openai": "deno run -A ./lib/cli/openai.ts",
    "google": "deno run -A ./lib/cli/google.ts",
    "vercel": "deno run -A ./lib/cli/vercel.ts",
    "anthropic": "deno run -A ./lib/cli/anthropic.ts",
    "send": "deno run -A ./lib/cli/send.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "vite": "npm:vite@^7.1.3",
    "preact": "npm:preact@^10.27.2",
    "@preact/signals": "npm:@preact/signals@^2.5.0",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "@ai-sdk/openai": "npm:@ai-sdk/openai",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk",
    "@google/generative-ai": "npm:@google/generative-ai",
    "@std/cli": "jsr:@std/cli",
    "@std/dotenv": "jsr:@std/dotenv",
    "ai": "npm:ai",
    "inngest": "npm:inngest@3.52.0",
    "openai": "npm:openai",
    "zod": "npm:zod@latest"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "fmt": {
    "exclude": [
      "**/node_modules"
    ]
  }
}
